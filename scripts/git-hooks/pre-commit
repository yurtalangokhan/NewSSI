#!/usr/bin/env -S LC_ALL=C.UTF-8 LANG=C.UTF-8 bash
set -euo pipefail

# Commits only auto-fix formatting; quality gates run on push (pre-push hook)
# or on demand via scripts/validate-commit.sh.
ROOT="$(git rev-parse --show-toplevel)"

exec "$ROOT/scripts/validation/quiet-run.sh" "pre-commit:autofix" -- \
  bash "$ROOT/scripts/quality/fix.sh" staged
