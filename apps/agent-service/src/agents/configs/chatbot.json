{
  "name": "chatbot",
  "type": "basic",
  "enabled": true,
  "description": "Simple chatbot agent with memory support",
  "class": "agents.impl.chatbot.ChatbotAgent",
  "defaults": {
    "model": "gpt-4o-mini",
    "temperature": 0.7,
    "long_term_memory": false,
    "max_history": 10
  },
  "config_schema": {
    "model": {
      "type": "string",
      "description": "Model name to use"
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "description": "Sampling temperature"
    },
    "long_term_memory": {
      "type": "boolean",
      "description": "Enable long-term memory"
    },
    "system_prompt": {
      "type": "string",
      "description": "System prompt override"
    }
  },
  "tags": ["production", "basic"]
}