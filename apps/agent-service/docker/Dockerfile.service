FROM python:3.12.3-slim

# pyproject.toml's [tool.uv.sources] points at its local-package siblings
# with paths relative to itself (../../packages/X), matching the real repo
# layout. WORKDIR mirrors that same depth so `uv sync` resolves those paths
# as they are; the previous image rewrote them with sed and then ran
# `uv lock`, regenerating the lock at build time and making the `--frozen`
# install below install whatever resolved then rather than what was reviewed.
WORKDIR /app/apps/agent-service

ENV UV_PROJECT_ENVIRONMENT="/usr/local/"
ENV UV_COMPILE_BYTECODE=1

COPY apps/agent-service/pyproject.toml .
COPY apps/agent-service/uv.lock ./
COPY packages/config-manager/ /app/packages/config-manager/
COPY packages/connector-py/ /app/packages/connector-py/
COPY packages/idempotency/ /app/packages/idempotency/
COPY packages/localization/ /app/packages/localization/
COPY packages/security/ /app/packages/security/
COPY packages/error-contract/ /app/packages/error-contract/
COPY packages/metrics/ /app/packages/metrics/
COPY packages/observability/ /app/packages/observability/
RUN pip install --no-cache-dir uv

# DejaVu ships the Unicode glyphs (ğ ş ı İ …) that reportlab's base-14 fonts lack.
# DocumentGenerationService registers it for PDF output; without it PDFs fall
# back to Helvetica and Turkish characters are dropped.
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# The mssql connector reaches SQL Server through pyodbc, which needs an ODBC
# driver on the host. Microsoft ODBC Driver 18 comes from Microsoft's own apt
# repository; ACCEPT_EULA=Y accepts its licence terms for this image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && . /etc/os-release \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/${VERSION_ID}/prod ${VERSION_CODENAME} main" \
        > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/*

RUN uv sync --frozen --no-install-project --no-dev \
    && rm -rf /root/.cache/uv /root/.cache/pip

COPY apps/agent-service/src/agents/ ./agents/
COPY apps/agent-service/src/agent_composition/ ./agent_composition/
COPY apps/agent-service/src/api/ ./api/
COPY apps/agent-service/src/client/ ./client/
COPY apps/agent-service/src/core/ ./core/
COPY apps/agent-service/src/infrastructure/ ./infrastructure/
COPY apps/agent-service/src/integrations/ ./integrations/
COPY apps/agent-service/src/memory/ ./memory/
COPY apps/agent-service/src/schemas/ ./schemas/
COPY apps/agent-service/src/service/ ./service/
COPY apps/agent-service/src/app.py .
COPY apps/agent-service/alembic.ini .
COPY apps/agent-service/locales/ ./locales/
RUN ln -s . src

# Run as an unprivileged user: a code-execution bug in the service should not
# start out with root inside the container.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app \
    && chown -R 10001:10001 /app
USER 10001

CMD ["python", "app.py"]
