FROM python:3.12.3-slim

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT="/usr/local/"
ENV UV_COMPILE_BYTECODE=1

COPY apps/agent-service/pyproject.toml .
COPY apps/agent-service/uv.lock* ./
COPY packages/idempotency-py/ packages/idempotency-py/
COPY packages/i18n-py/ packages/i18n-py/
COPY packages/error-contract-py/ packages/error-contract-py/
RUN pip install --no-cache-dir uv

# DejaVu ships the Unicode glyphs (ğ ş ı İ …) that reportlab's base-14 fonts lack.
# DocumentGenerationService registers it for PDF output; without it PDFs fall
# back to Helvetica and Turkish characters are dropped.
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Fix local-dev relative package paths for the Docker WORKDIR
RUN sed -i \
    -e 's|path = "../../packages/idempotency-py"|path = "packages/idempotency-py"|' \
    -e 's|path = "../../packages/i18n-py"|path = "packages/i18n-py"|' \
    -e 's|path = "../../packages/error-contract-py"|path = "packages/error-contract-py"|' \
    pyproject.toml \
    && uv lock \
    && uv sync --frozen --no-install-project --no-dev \
    && rm -rf /root/.cache/uv /root/.cache/pip

COPY apps/agent-service/src/agents/ ./agents/
COPY apps/agent-service/src/api/ ./api/
COPY apps/agent-service/src/client/ ./client/
COPY apps/agent-service/src/controller/ ./controller/
COPY apps/agent-service/src/core/ ./core/
COPY apps/agent-service/src/domain/ ./domain/
COPY apps/agent-service/src/memory/ ./memory/
COPY apps/agent-service/src/models/ ./models/
COPY apps/agent-service/src/schema/ ./schema/
COPY apps/agent-service/src/service/ ./service/
COPY apps/agent-service/src/app.py .
COPY apps/agent-service/src/run_service.py .
COPY apps/agent-service/alembic.ini .
COPY apps/agent-service/locales/ ./locales/
RUN ln -s . src

CMD ["python", "run_service.py"]
