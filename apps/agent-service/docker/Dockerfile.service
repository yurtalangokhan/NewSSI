FROM python:3.12.3-slim

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT="/usr/local/"
ENV UV_COMPILE_BYTECODE=1

COPY pyproject.toml .
COPY uv.lock* ./
RUN pip install uv

# --no-frozen: allow uv to update the lock file if pyproject.toml changed
RUN uv lock && uv sync --frozen --no-install-project --no-dev

COPY src/agents/ ./agents/
COPY src/api/ ./api/
COPY src/client/ ./client/
COPY src/controller/ ./controller/
COPY src/core/ ./core/
COPY src/domain/ ./domain/
COPY src/memory/ ./memory/
COPY src/schema/ ./schema/
COPY src/service/ ./service/
COPY src/app.py .
COPY src/run_service.py .
COPY alembic.ini .
# Symlink so alembic.ini's "src/core/..." path resolves inside /app/
RUN ln -s . src

CMD ["python", "run_service.py"]
