  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Collections List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/collections",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "collections"
          ]
        },
        "description": "Lists all available vector collections (name and UUID).",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Collections Create",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/collections",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "collections"
          ]
        },
        "description": "Creates a new vector collection by name with optional metadata.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sample Name\",\n  \"metadata\": {\n    \"key\": \"value\",\n    \"nested\": {\n      \"data\": \"example\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
