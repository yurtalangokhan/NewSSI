    {
      "name": "Documents List Chunks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/collections/{{collection_id}}/documents/{{document_id}}/chunks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "collections",
            "{{collection_id}}",
            "documents",
            "{{document_id}}",
            "chunks"
          ],
          "query": [
            {
              "key": "limit",
              "value": 20,
              "required": false
            },
            {
              "key": "offset",
              "value": 0,
              "required": false
            }
          ]
        },
        "description": "Lists a page of chunks (plus file-level stats) for a document (file_id).Chunks are paginated \u2014 large files can have thousands of chunks, andfetching them all in one response is heavy on both Milvus and thebrowser. Use `stats.total_chunks` / `has_more` to drive incrementalloading on the client.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
