    {
      "name": "Documents Upload Job Start",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/collections/{{collection_id}}/documents/upload-jobs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "collections",
            "{{collection_id}}",
            "documents",
            "upload-jobs"
          ]
        },
        "description": "Start an async upload/embedding job and return immediately.Poll /collections/{collection_id}/documents/upload-jobs/status to trackprogress. Progress survives page navigation on the frontend since it istracked server-side, keyed by collection_id.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
