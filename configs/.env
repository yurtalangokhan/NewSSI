EMBEDDING_PROVIDER=ollama

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_BIND_ADDR=0.0.0.0
REDIS_DB=0
REDIS_PASSWORD=dev-redis-password-change-me
# Container-reachable host names (compose service name); REDIS_HOST above is
# the host-side address. Two names, two independent consumers (APISIX vs.
# other app containers) — see docs/env-variables.md.
REDIS_HOST_CONTAINER=redis
REDIS_CONTAINER_HOST=redis
IDEMPOTENCY_TTL=86400
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_LOCK_TTL=10
IDEMPOTENCY_WAIT_TIMEOUT=10.0

# Agent runtime
MODE=dev

# Web / Next.js runtime
WEB_DOMAIN=http://localhost:3000
AUTH_TYPE=oidc
AGENT_SERVICE_URL='http://localhost:8000/agent-service'
USER_SERVICE_URL='http://localhost:8000/user-service'
RAG_SERVICE_URL='http://localhost:8000/rag-service'
TOOLS_SERVICE_URL='http://localhost:8000/tools-service/mcp'
MCP_INTERNAL_URL='http://localhost:8000/internal/tools-service/mcp'
NODE_ENV=development
OVERRIDE_API_PRODUCTION=true
VALID_API_KEYS=dev-key-123,prod-key-456
ATLAS_VERSION=dev
ENABLE_PAID_ENTERPRISE_EDITION_FEATURES=false
NEXT_PUBLIC_CLOUD_ENABLED=false
NEXT_PUBLIC_ENABLE_PAID_EE_FEATURES=false
NEXT_PUBLIC_TEST_ENV=false

# LOGGING
LOG_LEVEL=INFO
LOG_FORMAT=JSON

# --- Moved here from the per-service apps/*/.env files (now removed) ---
# Audience differs per service, so each uses the per-service prefix its
# settings already resolve ahead of the bare KEYCLOAK_AUDIENCE.
# user-service's pair is KEYCLOAK_USER_SERVICE_* above.

# rag-service CORS allow-list (JSON array).

# user-service external identity-provider federation.

# agent-service reads ENCRYPTION_KEY; user-service resolves
# LLM_PROVIDER_API_ENCRYPTION_KEY first. Same key under both names.

# Built application container image tag.
# Redis host reached by the APISIX container.
# Optional Keycloak external identity-provider alias.
# Optional JSON object mapping broker URLs to reachable URLs.
# Redis database for one-time Gateway OIDC state.

# PostHog ingestion host used by the web app
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_POSTHOG_HOST=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TURKSAT ATLAS
NEXT_PUBLIC_APP_URL=/
NEXT_PUBLIC_APP_DOMAIN=onyx.app
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_GTM_ENABLED=false
NEXT_PUBLIC_ENABLE_STATS=false
NEXT_PUBLIC_DISABLE_LOGOUT=false
NEXT_PUBLIC_FORGOT_PASSWORD_ENABLED=false
NEXT_PUBLIC_INCLUDE_ERROR_POPUP_SUPPORT_LINK=false
NEXT_PUBLIC_DO_NOT_USE_TOGGLE_OFF_DANSWER_POWERED=false

# Logging
LOG_OUTPUT=console
LOG_INCLUDE_SOURCE=true
LOG_QUIET_LOGGERS=
LOG_SYSLOG_ADDRESS=localhost:514
LOG_SYSLOG_FACILITY=user
LOG_ELASTICSEARCH_INDEX=
LOG_EXTERNAL_URL=
LOG_EXTERNAL_BEARER_TOKEN=
LOG_EXTERNAL_BATCH_SIZE=100
LOG_EXTERNAL_FLUSH_INTERVAL=5.0
LOG_EXTERNAL_MAX_QUEUE=1000
LOG_EXTERNAL_MAX_RETRIES=3
LOG_EXTERNAL_RETRY_BACKOFF=0.5
LOG_EXTERNAL_SHUTDOWN_TIMEOUT=10.0

# OPENTELEMETRY (traces + push metrics; off until enabled)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLE_RATIO=1.0
OTEL_METRICS_ENABLED=false
OTEL_METRICS_EXPORT_INTERVAL=60000

# OBSERVABILITY STACK (Elasticsearch, Kibana, Prometheus, Grafana)
# Elasticsearch stores the logs and traces; Kibana is the log/trace workspace;
# Prometheus stores metrics; Grafana renders all three. Host ports are
# loopback-only. Elasticsearch requires the host's vm.max_map_count >= 262144.
# Security is disabled for the single-node development cluster; a production
# deployment must enable xpack.security and set credentials.
ELASTIC_VERSION=8.15.2
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m
KIBANA_PORT=5601
PROMETHEUS_VERSION=v2.54.1
PROMETHEUS_PORT=9090
GRAFANA_VERSION=11.1.0
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dqH0Iov1T0wNUsH35COkZbLmR7arfbCc
LOG_RETENTION_DAYS=30
